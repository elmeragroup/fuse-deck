{
  "name": "@elmeragroup/fuse-deck",
  "version": "0.0.0",
  "private": true,
  "description": "Builds Fuse-themed slide decks from MDX, with a command line written for agents.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./components": {
      "types": "./dist/runtime/components.d.ts",
      "import": "./dist/runtime/components.js"
    }
  },
  "bin": {
    "fuse-deck": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "skill"
  ],
  "scripts": {
    "build": "tsdown",
    "fuse-deck": "node src/bin.ts",
    "test": "vitest run --project unit",
    "type-check": "tsrs --noEmit && tsrs --noEmit -p tsconfig.test.json",
    "test:browser": "vitest run --project browser",
    "pack": "rm -rf .artifacts && pnpm pack --pack-destination .artifacts",
    "test:packed-consumer": "node scripts/packed-smoke.ts"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@mdx-js/mdx": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "effect": "catalog:",
    "mdast-util-mdx-jsx": "catalog:",
    "postcss": "catalog:",
    "remark-frontmatter": "catalog:",
    "vite": "catalog:",
    "yaml": "catalog:"
  },
  "peerDependencies": {
    "@elmeragroup/fuse": "^0.1.0-canary.213",
    "react": "^19.3",
    "react-dom": "^19.3"
  },
  "devDependencies": {
    "@elmeragroup/deck-core": "workspace:*",
    "@elmeragroup/fuse": "catalog:",
    "@elmeragroup/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "tsrs": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
