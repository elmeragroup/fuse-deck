{
  "extends": "@elmeragroup/typescript-config/base.json",
  "compilerOptions": {
    // The command line runs in Node: no DOM types.
    "lib": ["ESNext"],
    // `node` runs the CLI from source by stripping types, which cannot run enums or parameter
    // properties.
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true
  },
  "include": ["src", "scripts", "tsdown.config.ts", "vitest.config.ts"]
}
