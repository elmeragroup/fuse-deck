{
  "extends": "@elmeragroup/typescript-config/base.json",
  "compilerOptions": {
    // The stub page runs in a sandboxed renderer: DOM types, no Node.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["@elmeragroup/typescript-config/css-custom-properties"],
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": ["src/renderer"]
}
