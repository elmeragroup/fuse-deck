{
  "extends": "@elmeragroup/typescript-config/base.json",
  "compilerOptions": {
    // Electron's main process, the preload and the scripts run in Node: no DOM types.
    "lib": ["ESNext"],
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true
  },
  "include": ["src", "scripts", "test", "tsdown.config.ts", "vitest.config.ts"]
}
