{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "bracketSpacing": true,
  "bracketSameLine": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "es5",
  "semi": true,
  "printWidth": 110,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortImports": {
    "newlinesBetween": true,
    "sortSideEffects": true,
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": ["react", "react/**"]
      },
      {
        "groupName": "elmera",
        "elementNamePattern": ["@elmeragroup", "@elmeragroup/**"]
      }
    ],
    "groups": [
      "react",
      ["builtin", "external", "internal", "subpath"],
      "elmera",
      ["parent", "sibling", "index"],
      "unknown"
    ]
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "**/node_modules/**",
    "dist",
    "**/dist/**",
    ".turbo",
    ".artifacts",
    ".cache",
    ".ref",
    ".scratch",
    "pnpm-lock.yaml",
    "*.log",
    ".DS_Store",
    ".agents/**",
    ".claude/**"
  ]
}
