{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "bracketSpacing": true,
  "bracketSameLine": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "es5",
  "semi": true,
  "printWidth": 110,
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortImports": {
    "newlinesBetween": true,
    "sortSideEffects": true,
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": ["react", "react/**"]
      },
      {
        "groupName": "elmera",
        "elementNamePattern": ["@elmeragroup", "@elmeragroup/**"]
      }
    ],
    "groups": [
      "react",
      ["builtin", "external", "internal", "subpath"],
      "elmera",
      ["parent", "sibling", "index"],
      "unknown"
    ]
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "**/node_modules/**",
    "dist",
    "**/dist/**",
    ".turbo",
    ".artifacts",
    ".cache",
    ".ref",
    ".scratch",
    ".decks",
    "pnpm-lock.yaml",
    "*.log",
    ".DS_Store",
    ".agents/**",
    ".claude/**",
    // Copied close to verbatim from t3code; upstream's formatting keeps them diffable. The same
    // list as the override in .oxlintrc.json.
    "apps/desktop/src/boot.ts",
    "apps/desktop/src/compileCache.ts",
    "apps/desktop/src/electron/Electron*.ts",
    "apps/desktop/src/ipc/DesktopIpc.ts",
    "apps/desktop/src/app/DesktopLifecycle.ts",
    "apps/desktop/src/app/DesktopShutdown.ts",
    "apps/desktop/src/app/DesktopState.ts",
    "apps/desktop/src/app/stdioErrors.ts",
    // Vendored from t3code with its formatting (packages/effect-acp/README.md).
    "packages/effect-acp/src/**",
    "packages/effect-acp/test/**",
    "packages/effect-acp/scripts/**"
  ]
}
